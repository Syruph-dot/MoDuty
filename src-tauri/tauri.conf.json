{
  "build": {
    "beforeBuildCommand": "npm --prefix desktop run build",
    "beforeDevCommand": "npm --prefix desktop run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../desktop/dist"
  },
  "package": {
    "productName": "MoDuty",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "notification": {
        "all": true
      },
      "shell": {
        "all": false,
        "execute": true,
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/momoka-server",
            "sidecar": true,
            "args": true,
            "env": {
              "MOMOKA_PORT_FILE": "1",
              "MOMOKA_PROJECT_ROOT": "1"
            }
          }
        ]
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/momoka-server"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.aronachest.app",
      "longDescription": "MoDuty — AI Agent tile-wall desktop shell powered by the MOMOKA Agent core.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": "MoDuty",
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "MoDuty — AI Agent tile-wall desktop",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "decorations": false,
        "fullscreen": true,
        "height": 600,
        "resizable": true,
        "title": "MoDuty",
        "width": 800
      }
    ]
  }
}
