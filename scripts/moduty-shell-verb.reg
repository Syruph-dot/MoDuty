[HKEY_CURRENT_USER\Software\Classes\Directory\shell\MoDuty.SendToDispatcher\command]
@="\"C:\\Windows\\System32\\wscript.exe\" //Nologo \"D:\\OBSIDIAN\\SyrVault1\\21_软件\\Project_KivoLAPIX\\MoDuty\\scripts\\moduty-launch.vbs\" \"%1\""

