# MOMOKA Desktop - tint2 panel config
# 极简顶栏：左侧 MOMOKA 标识，右侧 系统状态/时钟/电源

# --- Panel ---
panel_position = top center horizontal
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 0 4
panel_dock = 0
wm_menu = 0
panel_layer = top
panel_background_id = 1

# --- Panel Background ---
rounded = 0
border_width = 0
background_color = #1a1a2e 95
border_color = #000000 0

# --- Taskbar ---
taskbar_mode = single_desktop
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0

# --- Tasks ---
task_icon = 0
task_text = 1
task_centered = 1
urgent_nb_of_blink = 7
task_maximum_size = 180 24
task_padding = 6 2
task_background_id = 0
task_active_background_id = 2
task_urgent_background_id = 3
task_iconified_background_id = 0

# --- Task Backgrounds ---
task_background_id = 2
rounded = 4
border_width = 0
background_color = #3a3a5a 80
border_color = #000000 0

task_active_background_id = 2
rounded = 4
border_width = 0
background_color = #4a4a7a 90
border_color = #000000 0

task_urgent_background_id = 3
rounded = 4
border_width = 1
background_color = #7a3a3a 90
border_color = #aa4444 80

# --- System Tray ---
systray = 1
systray_padding = 4 2 4
systray_sort = ascending
systray_background_id = 0
systray_icon_size = 18
systray_icon_asb = 100 0 0

# --- Clock ---
time1_format = %H:%M
time1_font = Sans 11
time2_format = %Y-%m-%d
time2_font = Sans 9
clock_font_color = #eeeeee 95
clock_padding = 8 0
clock_background_id = 0
clock_lclick_command = gsimplecal
clock_rclick_command = gsimplecal

# --- Battery ---
battery = 1
battery_low_status = 15
battery_low_cmd = notify-send "Battery Low"
battery_hide = never
bat1_font = Sans 9
bat2_font = Sans 9
battery_font_color = #eeeeee 95
battery_padding = 8 0
battery_background_id = 0
battery_lclick_command = xfce4-power-manager-settings
battery_rclick_command = xfce4-power-manager-settings

# --- Separator ---
separator = 1
separator_background_id = 0
separator_color = #3a3a5a 50
separator_padding = 2 0

# --- Launcher (MOMOKA 标识) ---
launcher_icon_theme = Adwaita
launcher_padding = 8 0 8
launcher_background_id = 0
launcher_icon_size = 22
launcher_item_app = /opt/momoka/momoka.desktop

# --- Tooltip ---
tooltip = 1
tooltip_padding = 4 4
tooltip_show_timeout = 0.3
tooltip_hide_timeout = 0.1
tooltip_background_id = 4
tooltip_font_color = #eeeeee 100
tooltip_font = Sans 9

# --- Backgrounds ---
# 1: Panel bg
rounded = 0
border_width = 0
background_color = #1a1a2e 95
border_color = #000000 0

# 2: Task active
rounded = 4
border_width = 0
background_color = #4a4a7a 90
border_color = #000000 0

# 3: Task urgent
rounded = 4
border_width = 1
background_color = #7a3a3a 90
border_color = #aa4444 80

# 4: Tooltip
rounded = 4
border_width = 1
background_color = #2a2a4a 95
border_color = #4a4a7a 80