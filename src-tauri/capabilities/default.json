{
  "identifier": "default",
  "description": "MoDuty 桌面端最小权限：窗口最小化/关闭、监听通知按钮事件。后端端口与通知走自定义命令，不受 ACL 管辖。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
