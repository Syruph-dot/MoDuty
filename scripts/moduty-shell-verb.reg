[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\MoDuty.SendToDispatcher]
@="Send to MoDuty Dispatcher"
"Icon"="C:\\Windows\\System32\\shell32.dll"
"Position"="Top"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\MoDuty.SendToDispatcher\command]
@="\"C:\\Windows\\System32\\wscript.exe\" //Nologo \"D:\\OBSIDIAN\\SyrVault1\\21_软件\\Project_KivoLAPIX\\MoDuty\\scripts\\moduty-launch.vbs\" \"%V\""
