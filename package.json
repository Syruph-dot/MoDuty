{
  "name": "momoka-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript rewrite of MOMOKA with an interface-first Agent core.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc -p tsconfig.json",
    "build:frontend": "tsx scripts/build-frontend.ts",
    "test": "tsx --test \"tests-ts/**/*.test.ts\"",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.3",
    "zod": "^3.25.76"
  }
}
